// ======= INITIALIZATION =======
bool checkTouchHold() {
  static unsigned long touchStart = 0;
  static bool wasTouching = false;

  if (touchscreen.tirqTouched() && touchscreen.touched()) {
    if (!wasTouching) {
      wasTouching = true;
      touchStart = millis();
    }
    if (millis() - touchStart > 1000) {
      wasTouching = false;
      return true;
    }
  } else {
    wasTouching = false;
  }
  return false;
}

