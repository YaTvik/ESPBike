// ======= UPDATE LOAD =======
void updateLoad() {
  roadSlope = getRoadSlope();
  float speedFactor = currentSpeed / 30.0;
  float distFactor = tripDistance / 10.0;
  if (distFactor > 1.0) distFactor = 1.0;
  float slopeFactor = 1.0 + (roadSlope / 20.0) * 0.5;
  if (slopeFactor < 0.5) slopeFactor = 0.5;
  if (slopeFactor > 1.5) slopeFactor = 1.5;
  float baseLoad = (speedFactor * 0.6 + distFactor * 0.4) * 100.0 * slopeFactor;
  if (currentSpeed > 0 && tripActive) {
    loadAccumulator += (baseLoad / 60.0);
  }
  if (currentSpeed <= 12 && currentSpeed > 0) {
    loadAccumulator -= 0.4;
  }
  if (currentSpeed == 0) {
    loadAccumulator -= 1.0;
  }
  if (loadAccumulator < 0) loadAccumulator = 0;
  if (loadAccumulator > 100) loadAccumulator = 100;
  loadLevel = loadAccumulator;
}

// ======= PND =======
char getGear() {
  if (satellites == 0) return 'N';
  if (currentSpeed < 1) return 'P';
  return 'D';
}

// ======= UPDATE DATA =======
void updateData() {
  updateTime();
  updateDHT();

  bool hasFix = gps.getGnssFixOk();
  if (hasFix) {
    satellites = gps.getSIV();
    float speedMPS = gps.getGroundSpeed() / 1000.0;
    float speedKmph = speedMPS * 3.6;

    if (speedKmph < 1.5) {
      currentSpeed = 0;
    } else {
      currentSpeed = (int)(speedKmph + 0.5);
      lastValidSpeed = currentSpeed;
    }
    if (currentSpeed > 60) currentSpeed = 0;

    if (currentSpeed > 0) {
      if (!tripActive) tripActive = true;
      if (currentSpeed > tripMaxSpeed) tripMaxSpeed = currentSpeed;
      tripPauseTimer = millis();
    } else {
      if (tripActive && (millis() - tripPauseTimer > TRIP_PAUSE_DELAY)) {
        tripActive = false;
      }
    }
    if (currentSpeed > 0) {
      float met = 4.0 + (currentSpeed / 30.0) * 4.0;
      float durationHours = (float)tripElapsedSec / 3600.0;
      calories = met * USER_WEIGHT * durationHours;
    }
    if (!wasFix) { gpsFixSound(); wasFix = true; }

    // GPS coordinate-based distance calculation (from v7.1)
    float curLat = gps.getLatitude() / 10000000.0;
    float curLon = gps.getLongitude() / 10000000.0;

    if (!firstFix) {
      float dLat = curLat - lastLat;
      float dLon = curLon - lastLon;
      if (satellites > 0 && currentSpeed > 0) {
        const float R = 6371.0;
        float radDLat = radians(dLat);
        float radDLon = radians(dLon);
        float a = sin(radDLat / 2) * sin(radDLat / 2) +
                  cos(radians(lastLat)) * cos(radians(curLat)) *
                  sin(radDLon / 2) * sin(radDLon / 2);
        float c = 2 * atan2(sqrt(a), sqrt(1 - a));
        float dist = R * c;
        if (dist < 0.5 && dist > 0.0001) {
          totalDistance += dist;
          dailyDistance += dist;
          tripDistance += dist;
          saveDistance();
          saveStats();
        }
      }
    }
    lastLat = curLat;
    lastLon = curLon;
    firstFix = false;

  } else {
    currentSpeed = 0;
    satellites = 0;
    wasFix = false;
  }

  updateLoad();
  updateVibration();

  if (currentSpeed > (int)SPEED_LIMIT) {
    if (millis() - lastSpeedAlert > SPEED_ALERT_INTERVAL) {
      speedAlertSound();
      lastSpeedAlert = millis();
      speedAlertActive = true;
    }
  } else {
    speedAlertActive = false;
  }

  if (detectFall() && !fallDetected) {
    fallDetected = true;
    fallAlertTime = millis();
    sosSignal();
  }
  if (fallDetected && (millis() - fallAlertTime > FALL_ALERT_DURATION)) {
    fallDetected = false;
  }

  // Overload alert: 100% load → 3s beep, then 3min grace, then continuous until < 90%
  if (loadLevel >= 100 && currentSpeed > 0) {
    if (!overloadAlertActive) {
      overloadAlertActive = true;
      overloadPhase = 0;
      overloadBeepTimer = millis();
      if (soundEnabled) tone(BUZZER_PIN, 2500, 3000); // 3-second initial beep
    }

    if (overloadPhase == 0) {
      if (millis() - overloadBeepTimer >= 3000) {
        overloadPhase = 1;
        overloadBeepTimer = millis();
        noTone(BUZZER_PIN);
      }
    } else if (overloadPhase == 1) {
      // 3-minute grace period
      if (millis() - overloadBeepTimer >= 180000) {
        if (loadLevel >= 90) {
          overloadPhase = 2;
          overloadBeepTimer = millis();
        } else {
          overloadAlertActive = false;
          overloadPhase = 0;
          noTone(BUZZER_PIN);
        }
      }
    } else if (overloadPhase == 2) {
      if (loadLevel >= 90) {
        tone(BUZZER_PIN, 2500); // continuous beep
      } else {
        overloadAlertActive = false;
        overloadPhase = 0;
        noTone(BUZZER_PIN);
      }
    }
  } else {
    if (overloadAlertActive) {
      overloadAlertActive = false;
      overloadPhase = 0;
      noTone(BUZZER_PIN);
    }
  }
}

