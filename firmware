void findBestSector() {
  uint32_t bestCounter = 0xFFFFFFFF;
  currentSector = 0;
  for (int i = 0; i < EEPROM_NUM_SECTORS; i++) {
    int addr = i * EEPROM_SECTOR_SIZE;
    uint32_t magic, counter;
    EEPROM.get(addr + SECTOR_MAGIC, magic);
    EEPROM.get(addr + SECTOR_COUNTER, counter);
    if (magic == 0xBEEF && counter < bestCounter) {
      bestCounter = counter;
      currentSector = i;
    }
  }
  if (bestCounter == 0xFFFFFFFF) {
    currentSector = 0;
    eepromWriteCount = 0;
    int base = 0;
    EEPROM.put(base + SECTOR_MAGIC, (uint32_t)0xBEEF);
    EEPROM.put(base + SECTOR_COUNTER, (uint32_t)0);
    EEPROM.commit();
  } else {
    eepromWriteCount = bestCounter;
  }
}

void rotateSector() {
  int nextSector = (currentSector + 1) % EEPROM_NUM_SECTORS;
  int src = currentSector * EEPROM_SECTOR_SIZE;
  int dst = nextSector * EEPROM_SECTOR_SIZE;
  for (int i = 0; i < SECTOR_SIZE; i++) {
    EEPROM.write(dst + i, EEPROM.read(src + i));
  }
  eepromWriteCount++;
  EEPROM.put(dst + SECTOR_COUNTER, eepromWriteCount);
  uint32_t verifyCounter;
  EEPROM.get(dst + SECTOR_COUNTER, verifyCounter);
  if (verifyCounter == eepromWriteCount) {
    currentSector = nextSector;
  }
  EEPROM.commit();
}

void saveStats() {
  static int writeCounter = 0;
  writeCounter++;
  if (writeCounter >= 10) {
    writeCounter = 0;
    rotateSector();
  }
  int base = currentSector * EEPROM_SECTOR_SIZE;
  EEPROM.put(base + DAILY_ADDR, dailyDistance);
  EEPROM.put(base + MAX_SPEED_ADDR, tripMaxSpeed);
  EEPROM.put(base + TRIP_TIME_ADDR, tripElapsedSec);
  EEPROM.put(base + TOTAL_TRIP_TIME_ADDR, totalTripElapsedSec);
  EEPROM.put(base + CALORIES_ADDR, calories);
  EEPROM.commit();
}

void loadStats() {
  int base = currentSector * EEPROM_SECTOR_SIZE;
  EEPROM.get(base + DAILY_ADDR, dailyDistance);
  EEPROM.get(base + MAX_SPEED_ADDR, tripMaxSpeed);
  EEPROM.get(base + TRIP_TIME_ADDR, tripElapsedSec);
  EEPROM.get(base + TOTAL_TRIP_TIME_ADDR, totalTripElapsedSec);
  EEPROM.get(base + CALORIES_ADDR, calories);
  if (dailyDistance > 10000) dailyDistance = 0;
  if (tripMaxSpeed > 200) tripMaxSpeed = 0;
  if (tripElapsedSec > 86400) tripElapsedSec = 0;
  if (totalTripElapsedSec > 86400) totalTripElapsedSec = 0;
  if (calories > 10000) calories = 0;
}

