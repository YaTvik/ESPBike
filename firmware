// ======= HELPERS =======
String fmtTime(unsigned long sec) {
  int h = sec / 3600;
  int m = (sec % 3600) / 60;
  int s = sec % 60;
  char b[10];
  if (h > 0) sprintf(b, "%d:%02d:%02d", h, m, s);
  else sprintf(b, "%02d:%02d", m, s);
  return String(b);
}

