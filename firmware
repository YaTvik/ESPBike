  else if (dist < 10.0) return "Great ride!";
  else if (dist < 20.0) return "You are on fire!";
  else if (dist < 30.0) return "Amazing!";
  else return "LEGENDARY!";
}

// ======= PACER LOGIC =======
void updatePacer() {
  if (!pacerActive) return;

  // Check arrival
  float remainingDist = pacerTotalDist - tripDistance;
  if (remainingDist <= 0.05 && !pacerArrived) {
    pacerArrived = true;
    pacerArrivalTime = millis();
    pacerSuccessMelody();
    return;
  }

  // Show arrival screen for 10 seconds then auto-stop
  if (pacerArrived) {
    if (millis() - pacerArrivalTime > PACER_ARRIVAL_DISPLAY_DURATION) {
      stopPacer();
    }
    return;
  }

  unsigned long elapsed = (millis() - pacerStartTime) / 1000;
  unsigned long remainingTime = (pacerTotalTimeSec > elapsed) ? pacerTotalTimeSec - elapsed : 0;

  // Target speed is FIXED from start — no dynamic recalculation
  // pacerTargetSpeed remains as set in startPacer()

  // Warning if deviation > 5 km/h
  if (currentSpeed > 0 && abs(currentSpeed - pacerTargetSpeed) > 5.0) {
    if (millis() - pacerWarnTimer > 4000) {
      pacerWarnTimer = millis();
      pacerWarning = true;
      pacerWarningSound();
    }
  } else {
    pacerWarning = false;
  }

  if (pacerWarning && millis() - pacerWarnTimer > 2500) {
    pacerWarning = false;
  }

  // ETA calculation
  if (currentSpeed > 0) {
    float hoursRemaining = remainingDist / currentSpeed;
    unsigned long totalSec = currentHour * 3600UL + currentMinute * 60 + currentSecond + (unsigned long)(hoursRemaining * 3600);
    int etaH = (totalSec / 3600) % 24;
    int etaM = (totalSec / 60) % 60;
    char buf[16];
    sprintf(buf, "%02d:%02d", etaH, etaM);
    pacerETA = String(buf);
  } else {
    pacerETA = "--:--";
  }
}

void startPacer(unsigned long timeMin, float distKm) {
  pacerTotalTimeSec = timeMin * 60;
  pacerTotalDist = distKm;
  pacerStartTime = millis();
  pacerActive = true;
  pacerTargetSpeed = (distKm / (float)timeMin) * 60.0;
  pacerWarning = false;
  pacerETA = "--:--";
}

void stopPacer() {
  pacerActive = false;
  pacerWarning = false;
  pacerArrived = false;
  pacerTargetSpeed = 0;
  pacerETA = "";
  needFullRedraw = true;
}

