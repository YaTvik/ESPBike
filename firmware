void drawSpeedometer() {
  bool pacerBlink = pacerActive && pacerWarning && (millis() % 1000 < 500);
  if (currentSpeed == lastD_speed && lastD_speed >= 0 && !pacerBlink && !needFullRedraw) return;

  int cx = CX + 10;
  int cy = 130;
  int radius = 70;
  int maxSpeed = 50;

  tft.fillRect(40, 60, SCR_W - 40, 150, BG_COLOR);

  float angle = 180.0 - ((float)currentSpeed / maxSpeed) * 180.0;
  if (angle < 0) angle = 0;
  if (angle > 180) angle = 180;

  tft.drawArc(cx, cy, radius, radius - 10, 180, 0, DIM_COLOR, BG_COLOR, true);
  if (currentSpeed > 0) {
    uint16_t col = speedColor(currentSpeed);
    if (pacerActive && abs(currentSpeed - pacerTargetSpeed) > 2.0) {
      col = WARN_COLOR;
    }
    tft.drawArc(cx, cy, radius, radius - 10, 180, angle, col, BG_COLOR, true);
  }

  for (int i = 0; i <= 10; i++) {
    int val = i * 5;
    float ang = 180.0 - ((float)val / maxSpeed) * 180.0;
    float rad = ang * DEG_TO_RAD;
    int x1 = cx + (radius - 4) * cos(rad);
    int y1 = cy - (radius - 4) * sin(rad);
    int x2 = cx + (radius - 14) * cos(rad);
    int y2 = cy - (radius - 14) * sin(rad);
    uint16_t col = (i % 2 == 0) ? TEXT_COLOR : DIM_COLOR;
    tft.drawLine(x1, y1, x2, y2, col);
    if (i % 2 == 0) {
      int xt = cx + (radius - 24) * cos(rad);
      int yt = cy - (radius - 24) * sin(rad);
      tft.setTextDatum(MC_DATUM);
      tft.setTextSize(1);
      tft.setTextColor(DIM_COLOR, BG_COLOR);
      tft.drawString(String(val), xt, yt);
    }
  }

  int arrowLen = radius - 20;
  float rad = angle * DEG_TO_RAD;
  int x = cx + arrowLen * cos(rad);
  int y = cy - arrowLen * sin(rad);
  tft.drawLine(cx, cy, x, y, ACCENT_COLOR);
  tft.fillCircle(cx, cy, 5, ACCENT_COLOR);

  uint16_t spdCol = TEXT_COLOR;
  if (pacerActive) {
    if (pacerBlink) spdCol = WARN_COLOR;
    else if (abs(currentSpeed - pacerTargetSpeed) > 5.0) spdCol = WARN_COLOR;
  }

  tft.setTextDatum(MC_DATUM);
  tft.setTextSize(6);
  tft.setTextColor(spdCol, BG_COLOR);
  tft.drawString(String(currentSpeed), cx, cy + 6);
  tft.setTextSize(1);
  tft.setTextColor(ACCENT_COLOR, BG_COLOR);
  tft.drawString("km/h", cx, cy + 30);
  tft.setTextSize(2);
  tft.setTextColor(ACCENT_COLOR, BG_COLOR);
  tft.drawString(String(getGear()), cx, cy + 48);

  if (pacerActive && !pacerArrived) {
    tft.setTextSize(2);
    tft.setTextColor(PACER_COLOR, BG_COLOR);
    char buf[32];
    sprintf(buf, "Speed:%.1f", pacerTargetSpeed);
    tft.drawString(buf, cx, cy + 62);
  }

  lastD_speed = currentSpeed;
}

