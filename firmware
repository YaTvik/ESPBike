// ======= MPU6050 =======
bool initMPU6050() {
  Wire.begin(I2C_SDA, I2C_SCL);
  Wire.beginTransmission(MPU6050_ADDR);
  if (Wire.endTransmission() != 0) return false;
  Wire.beginTransmission(MPU6050_ADDR);
  Wire.write(0x6B); Wire.write(0x00);
  Wire.endTransmission();
  Wire.beginTransmission(MPU6050_ADDR);
  Wire.write(0x1C); Wire.write(0x10);
  Wire.endTransmission();
  Wire.beginTransmission(MPU6050_ADDR);
  Wire.write(0x1B); Wire.write(0x10);
  Wire.endTransmission();
  delay(100);
  return true;
}

void readMPU6050() {
  Wire.beginTransmission(MPU6050_ADDR);
  Wire.write(0x3B);
  Wire.endTransmission(false);
  Wire.requestFrom(MPU6050_ADDR, 14, true);
  int16_t rawX = Wire.read() << 8 | Wire.read();
  int16_t rawY = Wire.read() << 8 | Wire.read();
  int16_t rawZ = Wire.read() << 8 | Wire.read();
  int16_t rawTemp = Wire.read() << 8 | Wire.read();
  int16_t rawGyroX = Wire.read() << 8 | Wire.read();
  int16_t rawGyroY = Wire.read() << 8 | Wire.read();
  int16_t rawGyroZ = Wire.read() << 8 | Wire.read();
  accelX = rawX / 4096.0;
  accelY = rawY / 4096.0;
  accelZ = rawZ / 4096.0;
  gyroX = rawGyroX / 32.8;
  gyroY = rawGyroY / 32.8;
  gyroZ = rawGyroZ / 32.8;
}

void detectAxes() {
  float ax = 0, ay = 0, az = 0;
  for (int i = 0; i < 10; i++) {
    readMPU6050();
    ax += abs(accelX);
    ay += abs(accelY);
    az += abs(accelZ);
    delay(10);
  }
  ax /= 10; ay /= 10; az /= 10;
  if (az > ax && az > ay) {
    upAxis = 2;
    forwardAxis = (ax > ay) ? 0 : 1;
  } else if (ay > ax && ay > az) {
    upAxis = 1;
    forwardAxis = (ax > az) ? 0 : 2;
  } else {
    upAxis = 0;
    forwardAxis = (ay > az) ? 1 : 2;
  }
}

void calibrateSlope() {
  if (slopeCalibrated) return;
  float samplesF[50];
  float samplesU[50];
  for (int i = 0; i < 50; i++) {
    readMPU6050();
    float f, u;
    switch (forwardAxis) {
      case 0: f = accelX; break;
      case 1: f = accelY; break;
      default: f = accelZ; break;
    }
    switch (upAxis) {
      case 0: u = accelX; break;
      case 1: u = accelY; break;
      default: u = accelZ; break;
    }
    samplesF[i] = f;
    samplesU[i] = u;
    delay(10);
  }
  // Sort and take median (more robust against outliers)
  for (int i = 0; i < 49; i++) {
    for (int j = i + 1; j < 50; j++) {
      if (samplesF[i] > samplesF[j]) { float t = samplesF[i]; samplesF[i] = samplesF[j]; samplesF[j] = t; }
      if (samplesU[i] > samplesU[j]) { float t = samplesU[i]; samplesU[i] = samplesU[j]; samplesU[j] = t; }
    }
  }
  calibForward = samplesF[25]; // median
  calibUp = samplesU[25];      // median
  slopeCalibrated = true;
}

float getRoadSlope() {
  float forward, up;
  switch (forwardAxis) {
    case 0: forward = accelX - calibForward; break;
    case 1: forward = accelY - calibForward; break;
    default: forward = accelZ - calibForward; break;
  }
  switch (upAxis) {
    case 0: up = accelX - calibUp; break;
    case 1: up = accelY - calibUp; break;
    default: up = accelZ - calibUp; break;
  }
  float g = sqrt(forward*forward + up*up);
  if (g < 0.01) g = 0.01;
  float pitchRad = atan2(-forward, up);
  float percent = tan(pitchRad) * 100.0;
  return percent;
}

void checkSlopeRapidChange() {
  if (millis() - lastSlopeCheckTime < SLOPE_CHECK_INTERVAL) return;
  lastSlopeCheckTime = millis();

  // ANY vibration alert when speed > 10 km/h
  if (vibrationLevel > VIBRATION_THRESHOLD && currentSpeed > 10) {
    if (!slopeAlertActive) {
      slopeAlertActive = true;
      slopeAlertTime = millis();
      if (soundEnabled) {
        tone(BUZZER_PIN, 1800, 200); delay(250);
        tone(BUZZER_PIN, 1800, 200); delay(250);
        tone(BUZZER_PIN, 1800, 200); delay(250);
        noTone(BUZZER_PIN);
      }
    }
  }

  if (slopeAlertActive && millis() - slopeAlertTime > SLOPE_ALERT_DURATION) {
    slopeAlertActive = false;
  }
}

// ======= VIBRATION =======
void updateVibration() {
  static float prevAccel = 0;
  float currentAccel = sqrt(accelX*accelX + accelY*accelY + accelZ*accelZ);
  float delta = abs(currentAccel - prevAccel);
  prevAccel = currentAccel;
  vibrationLevel = vibrationLevel * 0.8 + delta * 0.2;
  if (vibrationLevel > VIBRATION_THRESHOLD && currentSpeed > 5) {
    if (!vibrationWarningActive) {
      vibrationWarningActive = true;
      vibrationWarningTime = millis();
      vibrationWarningSound();
    }
  }
  if (vibrationWarningActive && millis() - vibrationWarningTime > VIBRATION_WARNING_DURATION) {
    vibrationWarningActive = false;
  }
}

// ======= DHT11 =======
void readDHT11() {
  float t = dht.readTemperature();
  float h = dht.readHumidity();
  if (!isnan(t) && !isnan(h)) {
    temperature = t;
    humidity = h;
    dhtDataValid = true;
  } else {
    dhtDataValid = false;
  }
}

void updateDHT() {
  if (millis() - lastDHTRead > DHT_UPDATE_INTERVAL) {
    readDHT11();
    lastDHTRead = millis();
  }
}

void forceDHTUpdate() {
  readDHT11();
  lastDHTRead = millis();
}

// ======= FALL =======
bool detectFall() {
  static float fx = 0, fy = 0, fz = 0;
  fx = fx * 0.7 + accelX * 0.3;
  fy = fy * 0.7 + accelY * 0.3;
  fz = fz * 0.7 + accelZ * 0.3;
  if (abs(fx) > 1.5 || abs(fy) > 1.5 || abs(fz) > 1.5) {
    fallCounter++;
    if (fallCounter > 3) { fallCounter = 0; return true; }
  } else {
    fallCounter = 0;
  }
  return false;
}

// ======= AUTO THEME =======
void updateTheme() {
  static bool themeLocked = false;
  static bool lockedDark = false;
  bool hasFix = gps.getGnssFixOk();
  bool shouldBeDark;

  if (!timeSet) {
    shouldBeDark = true;
    themeLocked = false;
  } else if (!hasFix) {
    if (!themeLocked) {
      lockedDark = isDarkTheme;
      themeLocked = true;
    }
    shouldBeDark = lockedDark;
  } else {
    themeLocked = false;
    shouldBeDark = (currentHour >= 6 && currentHour < 21);
  }

  if (shouldBeDark != isDarkTheme) {
    isDarkTheme = shouldBeDark;
    if (shouldBeDark) {
      BG_COLOR = BG_DARK;
      TEXT_COLOR = TEXT_DARK;
      ACCENT_COLOR = ACCENT_DARK;
    } else {
      BG_COLOR = BG_LIGHT;
      TEXT_COLOR = TEXT_LIGHT;
      ACCENT_COLOR = ACCENT_LIGHT;
    }
    needFullRedraw = true;
  }
}

// ======= TIME =======
void updateTime() {
  if (gps.getTimeValid() && gps.getGnssFixOk()) {
    int utcHour = gps.getHour();
    int utcMinute = gps.getMinute();
    int utcSecond = gps.getSecond();
    currentHour = (utcHour + HOUR_OFFSET) % 24;
    currentMinute = utcMinute;
    currentSecond = utcSecond;
    timeSet = true;
    lastTimeUpdate = millis();
    char buf[6];
    sprintf(buf, "%02d:%02d", currentHour, currentMinute);
    timeStr = String(buf);
  } else if (timeSet) {
    unsigned long elapsed = (millis() - lastTimeUpdate) / 1000;
    unsigned long totalSec = currentHour * 3600UL + currentMinute * 60 + currentSecond + elapsed;
    currentHour = (totalSec / 3600) % 24;
    currentMinute = (totalSec / 60) % 60;
    currentSecond = totalSec % 60;
    char buf[6];
    sprintf(buf, "%02d:%02d", currentHour, currentMinute);
    timeStr = String(buf);
  } else {
    timeStr = "TIME ?";
  }
  updateTheme();
}

