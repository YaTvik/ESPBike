bool runInitialization(bool fromSettings) {
  inInitScreen = true;

  if (!fromSettings) {
    tft.fillScreen(BG_COLOR);
    tft.setTextDatum(MC_DATUM);
    tft.setTextSize(3);
    tft.setTextColor(ACCENT_COLOR, BG_COLOR);
    tft.drawString("ESPBike", CX, 80);
    tft.setTextSize(2);
    tft.setTextColor(TEXT_COLOR, BG_COLOR);
    tft.drawString("By YaTvik", CX, 140);
    delay(1500);
  }

  tft.fillScreen(BG_COLOR);
  tft.setTextDatum(TL_DATUM);
  tft.setTextSize(2);
  tft.setTextColor(ACCENT_COLOR, BG_COLOR);
  tft.drawString("INITIALIZING...", 15, 20);

  EEPROM.begin(EEPROM_SIZE);
  findBestSector();
  loadDistance();
  loadStats();
  modules.eepromOK = true;

  int y = 60;
  auto ok = [&](const char* name, bool good, const char* failName) -> bool {
    tft.setTextSize(1);
    tft.setTextColor(ACCENT_COLOR, BG_COLOR);
    tft.drawString(name, 20, y);
    if (good) {
      tft.setTextColor(OK_COLOR, BG_COLOR);
      tft.drawString("[ OK ]", 170, y);
      y += 22;
      return true;
    } else {
      tft.setTextColor(ALERT_COLOR, BG_COLOR);
      tft.drawString("[FAIL]", 170, y);
      y += 22;
      showInitError(failName);
      unsigned long errorStart = millis();
      while (millis() - errorStart < 30000) {
        if (checkTouchHold()) {
          menuSound();
          tft.fillScreen(BG_COLOR);
          tft.setTextDatum(TL_DATUM);
          tft.setTextSize(2);
          tft.setTextColor(ACCENT_COLOR, BG_COLOR);
          tft.drawString("INITIALIZING...", 15, 20);
          y = 60;
          return false;
        }
        delay(50);
      }
      return false;
    }
  };

  modules.tftOK = true;
  delay(200); 
  if (!ok("TFT", true, "TFT")) {}

  delay(200); 
  if (!ok("EEPROM", modules.eepromOK, "EEPROM")) { modules.eepromOK = false; }

  delay(200); 
  touchscreenSPI.begin(XPT2046_CLK, XPT2046_MISO, XPT2046_MOSI, XPT2046_CS);
  touchscreen.begin(touchscreenSPI); 
  touchscreen.setRotation(0); 
  modules.touchOK = true;
  if (!ok("TOUCH", true, "TOUCH")) { modules.touchOK = false; }

  delay(200); 
  modules.mpuOK = initMPU6050();
  if (!ok("MPU6050", modules.mpuOK, "MPU6050")) { modules.mpuOK = false; }

  if (modules.mpuOK) {
    detectAxes();
    calibrateSlope();
  }

  delay(300); 
  gpsSerial.begin(38400, SERIAL_8N1, GPS_RX_PIN, GPS_TX_PIN); 
  modules.gpsOK = gps.begin(gpsSerial);
  if (!ok("GPS", modules.gpsOK, "GPS")) { modules.gpsOK = false; }

  delay(200); 
  initBuzzer(); 
  if (!ok("BUZZER", true, "BUZZER")) { modules.buzzerOK = false; }

  delay(200); 
  dht.begin(); 
  readDHT11(); 
  modules.dhtOK = dhtDataValid;
  if (!ok("DHT11", modules.dhtOK, "DHT11")) { modules.dhtOK = false; }

  float eepromHealth = getEEPROMHealth();
  tft.setTextSize(2);
  uint16_t healthColor = (eepromHealth > 60) ? OK_COLOR : (eepromHealth > 30) ? WARN_COLOR : ALERT_COLOR;
  tft.setTextColor(healthColor, BG_COLOR);
  char healthBuf[40];
  sprintf(healthBuf, "EEPROM: %.0f%%", eepromHealth);
  tft.drawString(healthBuf, 20, y);
  y += 28;

  if (eepromHealth < 30) {
    tft.setTextSize(2);
    tft.setTextColor(ALERT_COLOR, BG_COLOR);
    tft.drawString("WARNING: EEPROM LOW!", 20, y);
    y += 28;
  }

  tft.setTextSize(2);
  tft.setTextColor(OK_COLOR, BG_COLOR);
  tft.drawString("SYSTEM READY!", 40, y + 15);
  startupMelody();
  delay(1500);

  if (!fromSettings) {
    tft.fillScreen(WARN_COLOR);
    tft.setTextDatum(MC_DATUM);
    tft.setTextSize(3);
    tft.setTextColor(TFT_BLACK, WARN_COLOR);
    tft.drawString("!", CX, 60);
    tft.setTextSize(2);
    tft.setTextColor(TFT_RED, WARN_COLOR);
    tft.drawString("ATTENTION!", CX, 120);
    tft.setTextSize(1);
    tft.setTextColor(TFT_BLACK, WARN_COLOR);
    tft.drawString("CHECK BEFORE RIDE!", CX, 160);
    tft.drawString("CHECK BRAKES", CX, 180);
    tft.drawString("AND ALL BOLTS!", CX, 198);
    delay(4000);
  }

  inInitScreen = false;
  return true;
}

// ======= TOUCH HANDLING =======
void handleTouch() {
  if (sleepModeActive) {
    if (touchscreen.tirqTouched() && touchscreen.touched()) {
      wakeUp();
    }
    return;
  }

  if (touchscreen.tirqTouched() && touchscreen.touched()) {
    TS_Point p = touchscreen.getPoint();
    int x = map(p.x, 200, 3700, 0, 240);
    int y = map(p.y, 240, 3800, 0, 320);
    lastActivityTime = millis();

    if (!touchPressed) {
      touchPressed = true;
      touchStartTime = millis();
    }
    if (inPacerInput) {
      handlePacerTouch(x, y);
      touchPressed = false;
      return;
    }
    if (inSettingsMenu) {
      handleTouchMenu(x, y);
      touchPressed = false;
      return;
    }
    if (inStatsMenu) {
      inStatsMenu = false;
      needFullRedraw = true;
      menuSound();
      touchPressed = false;
      return;
    }
    if (inInitScreen) {
      touchPressed = false;
      return;
    }
    if (x >= BTN1_X && x <= BTN1_X + BTN_W &&
        y >= BTN_Y && y <= BTN_Y + BTN_H) {
      inSettingsMenu = true;
      drawSettingsMenu();
      menuSound();
      touchPressed = false;
      return;
    }
    if (x >= BTN2_X && x <= BTN2_X + BTN_W &&
        y >= BTN_Y && y <= BTN_Y + BTN_H) {
      inStatsMenu = true;
      drawStatsMenu();
      menuSound();
      touchPressed = false;
      return;
    }
    if (x >= BTN3_X && x <= BTN3_X + BTN_W &&
        y >= BTN_Y && y <= BTN_Y + BTN_H) {
      if (pacerActive) {
        stopPacer();
        menuSound();
        showToast("PACER stopped");
      } else {
        inPacerInput = true;
        pacerInputStep = 0;
        pacerInputBuffer = "";
        menuSound();
        drawPacerInput("ENTER TIME", "minutes");
      }
      touchPressed = false;
      return;
    }
    if (x >= BTN4_X && x <= BTN4_X + BTN_W &&
        y >= BTN_Y && y <= BTN_Y + BTN_H) {
      restartDevice();
      touchPressed = false;
      return;
    }
    // Long-press removed — all actions are tap-only now
    if (currentPage == 0) {
      currentPage = 1;
      needFullRedraw = true;
      menuSound();
    } else {
      currentPage = 0;
      needFullRedraw = true;
      menuSound();
    }
    touchPressed = false;
  } else {
    touchPressed = false;
  }
  if (inSettingsMenu) {
    if (millis() - settingsEnterTime > 15000) {
      if (!settingsClosingSoundPlayed) {
        settingsCloseSound();
        settingsClosingSoundPlayed = true;
      }
      inSettingsMenu = false;
      needFullRedraw = true;
    }
  }
}

// ======= SETUP =======
void setup() {
  Serial.begin(115200);
  BG_COLOR = BG_LIGHT;
  TEXT_COLOR = TEXT_LIGHT;
  ACCENT_COLOR = ACCENT_LIGHT;
  tft.init();
  tft.setRotation(0);
  tft.fillScreen(BG_COLOR);
  tft.setTextWrap(false);

  runInitialization(false);

  bootTime = millis();
  dailyResetDone = false;
  lastActivityTime = millis();
  needFullRedraw = true;
}

// ======= LOOP =======
void loop() {
  if (millis() - lastSecTimer > 1000) {
    lastSecTimer = millis();

    if (currentSpeed > 0) {
      tripElapsedSec++;
    }
    totalTripElapsedSec++;

    if (currentSpeed == 0 && millis() - tripPauseTimer > TRIP_PAUSE_DELAY * 2) {
      lastValidSpeed = 0;
    }
  }

  if (millis() - lastGPSTime > GPS_INTERVAL) {
    updateData();
    lastGPSTime = millis();
  }
  if (millis() - lastMPUTime > MPU_INTERVAL) {
    readMPU6050();
    lastMPUTime = millis();
  }

  updateTheme();
  updatePacer();
  checkSlopeRapidChange();
  handleTouch();
  checkDailyReset();
  checkSleepMode();

  if (showLoadReduced && millis() - loadReducedTimer > 4000) {
    showLoadReduced = false;
    needFullRedraw = true;
  }

  // Slope indicator update every 100ms for responsiveness
  if (!inSettingsMenu && !inStatsMenu && !inInitScreen && !inPacerInput && !(pacerActive && pacerArrived) && millis() - lastSlopeDrawTime > SLOPE_DRAW_INTERVAL) {
    drawSlopeArrow();
    lastSlopeDrawTime = millis();
  }

  if (!inSettingsMenu && !inStatsMenu && !inInitScreen && !inPacerInput && millis() - lastDrawTime > DRAW_INTERVAL) {
    if (currentPage == 0) {
      drawUI();
    } else {
      drawPageStats();
    }
    lastDrawTime = millis();
  }

  static unsigned long lastDebug = 0;
  if (millis() - lastDebug > 2000) {
    lastDebug = millis();
    float raw = gps.getGroundSpeed();
    float pitchX = atan2(-accelX, sqrt(accelY*accelY + accelZ*accelZ)) * 180.0/PI;
    float pitchY = atan2(-accelY, sqrt(accelX*accelX + accelZ*accelZ)) * 180.0/PI;
    float pitchZ = atan2(accelZ, sqrt(accelX*accelX + accelY*accelY)) * 180.0/PI;

    Serial.print("RAW mm/s: "); Serial.print(raw, 0);
    Serial.print(" | KMPH: "); Serial.print(currentSpeed);
    Serial.print(" | SAT: "); Serial.print(satellites);
    Serial.print(" | FIX: "); Serial.print(gps.getGnssFixOk() ? "YES" : "NO");
    Serial.print(" | AVG: "); Serial.print(tripAvgSpeed, 1);
    Serial.print(" | LOAD: "); Serial.print(loadLevel, 1);
    Serial.print(" | SLOPE: "); Serial.print(roadSlope, 1);
    Serial.print(" | THEME: "); Serial.print(isDarkTheme ? "DARK" : "LIGHT");
    Serial.print(" | timeSet: "); Serial.print(timeSet ? "YES" : "NO");
    Serial.print(" | HOUR: "); Serial.print(currentHour);
    Serial.print(" | ACC X/Y/Z: ");
    Serial.print(accelX, 2); Serial.print("/");
    Serial.print(accelY, 2); Serial.print("/");
    Serial.print(accelZ, 2);
    Serial.print(" | PITCHes X/Y/Z: ");
    Serial.print(pitchX, 1); Serial.print("/");
    Serial.print(pitchY, 1); Serial.print("/");
    Serial.print(pitchZ, 1);
    Serial.print(" | FWD_AXIS: "); Serial.print(forwardAxis);
    Serial.print(" | UP_AXIS: "); Serial.print(upAxis);
    Serial.print(" | VIB: "); Serial.print(vibrationLevel, 2);
    Serial.print(" | LAST_VALID: "); Serial.print(lastValidSpeed, 1);
    Serial.print(" | EEPROM_HEALTH: "); Serial.print(getEEPROMHealth(), 1);
    Serial.print(" | PACER: "); Serial.print(pacerActive ? "ON" : "OFF");
    if (pacerActive) {
      Serial.print(" | TGT: "); Serial.print(pacerTargetSpeed, 1);
      Serial.print(" | ETA: "); Serial.print(pacerETA);
    }
    Serial.println("%");
  }
  delay(5);
}
