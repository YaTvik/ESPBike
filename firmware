float getEEPROMHealth() {
  const uint32_t MAX_WRITES = 100000;
  if (eepromWriteCount > MAX_WRITES) return 0.0;
  return 100.0 * (1.0 - (float)eepromWriteCount / MAX_WRITES);
}

